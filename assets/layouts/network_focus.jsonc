{
    // Network Focus: Network + Disk I/O side by side, process list below
    "name": "Network Focus",
    "root": {
        "direction": "vertical",
        "areas": [
            { "widget": "header", "size": 3 },
            {
                "direction": "horizontal",
                "size": "50%",
                "areas": [
                    { "widget": "network", "size": "50%" },
                    { "widget": "disk_io", "size": "50%" }
                ]
            },
            { "widget": "processes", "size": "*" }
        ]
    }
}
